# ==============================================================================
# Terraform Variables Example
# Project: Logitrack Pro - Smart Logistics and Delivery Management System
#
# INSTRUCTIONS:
# 1. Copy this file to 'terraform.tfvars':
#    Copy-Item terraform.tfvars.example terraform.tfvars
# 2. Find your current public IP in PowerShell:
#    (Invoke-RestMethod -Uri "https://checkip.amazonaws.com").Trim()
# 3. Replace 'YOUR_PUBLIC_IP/32' with your actual public IP in CIDR format
#    (e.g., "103.21.124.50/32")
# ==============================================================================

aws_region          = "ap-south-1"
aws_profile         = "terraform"
vpc_id              = "vpc-01a8f7b2a1636ff42"
subnet_id           = "subnet-013444dc3c677a87b"
ami_id              = "ami-0dc0718b8dd0dedd8"
instance_type       = "t3.small"
key_name            = "dev2"
security_group_name = "launch-wizard-6"
instance_name       = "sample"

# Set your own public IP address in CIDR format (/32)
ssh_cidr            = "YOUR_PUBLIC_IP/32"
