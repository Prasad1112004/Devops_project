# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files with potential sensitive values or local IPs
*.tfvars
!terraform.tfvars.example
*.auto.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Editor / OS files
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Terraform plan files
*.tfplan
*.plan
