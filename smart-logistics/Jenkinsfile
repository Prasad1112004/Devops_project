
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 40, unit: 'MINUTES')
    }

    environment {
        FRONTEND_IMAGE = 'prasad1112004/logitrack-frontend'
        BACKEND_IMAGE  = 'prasad1112004/logitrack-backend'

        FRONTEND_TAG = 'v3'
        BACKEND_TAG  = 'v3'

        DOCKER_BUILDKIT = '1'
    }

    stages {

        stage('Checkout Verification') {
            steps {
                checkout scm
                echo 'GitHub repository checked out successfully.'
            }
        }

        stage('Verify Project Structure') {
            steps {
                sh '''
                    test -f smart-logistics/frontend/package.json
                    test -f smart-logistics/backend/package.json
                    test -f smart-logistics/frontend/Dockerfile
                    test -f smart-logistics/backend/Dockerfile

                    echo "All required project files found."
                '''
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                    docker build \
                      -t ${FRONTEND_IMAGE}:${FRONTEND_TAG} \
                      -f smart-logistics/frontend/Dockerfile \
                      smart-logistics/frontend
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    docker build \
                      -t ${BACKEND_IMAGE}:${BACKEND_TAG} \
                      -f smart-logistics/backend/Dockerfile \
                      smart-logistics/backend
                '''
            }
        }

        stage('Push Images to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DH_USERNAME',
                        passwordVariable: 'DH_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -e

                        trap 'docker logout >/dev/null 2>&1 || true' EXIT

                        echo "$DH_TOKEN" | docker login \
                            --username "$DH_USERNAME" \
                            --password-stdin

                        docker push ${FRONTEND_IMAGE}:${FRONTEND_TAG}
                        docker push ${BACKEND_IMAGE}:${BACKEND_TAG}

                        echo "Both images pushed successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Logitrack Pro CI/CD image build and push completed!'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }
    }
}
